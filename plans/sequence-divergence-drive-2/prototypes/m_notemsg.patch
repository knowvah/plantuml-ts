--- /dev/null
+++ b/src/diagrams/sequence/proto-tile.ts
@@ -0,0 +1,6 @@
+// PROTOTYPE: last message tile extent for CommunicationTileNote* wrappers.
+export interface LastTile { top: number; height: number }
+const T = new WeakMap<object, LastTile>();
+export function setLastTile(ctx: object, top: number, height: number): void { T.set(ctx, { top, height }); }
+export function getLastTile(ctx: object): LastTile | undefined { return T.get(ctx); }
+export function clearLastTile(ctx: object): void { T.delete(ctx); }
