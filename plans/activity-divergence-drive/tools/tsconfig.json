{
  // Ad-hoc program for manually type-checking this mission's scratch
  // tooling. Not wired into `npm run typecheck` — the root program's
  // `include` is `["src", "tests", "demo"]` and `tsconfig.node.json`'s is
  // `["...", "scripts/**/*.ts"]`; neither reaches `plans/`. Run with:
  // `npx tsc --noEmit -p plans/activity-divergence-drive/tools`.
  "extends": "../../../tsconfig.node.json",
  "compilerOptions": {
    // These tools import `.mts` siblings by their literal extension
    // (jiti/Node ESM resolve them directly) and this program only ever
    // runs `--noEmit`, so `allowImportingTsExtensions` is safe here
    // without being a banned pattern. `rootDir` is inherited from
    // `tsconfig.json` (repo root) — overriding it here breaks TS6059 for
    // every upstream file this program's imports reach into (src/,
    // tests/oracle/, tests/helpers/).
    "allowImportingTsExtensions": true
  },
  "include": ["*.mts", "*.ts"]
}
