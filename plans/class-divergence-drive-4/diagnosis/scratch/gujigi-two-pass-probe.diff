+
+function probeTwoPass(entries: ConstraintEntry[]): void {
+  const [Dx, Dy] = process.env.GUJ_PROBE!.split(',').map(Number) as [number, number];
+  const pick = (e: ConstraintEntry, ox: number, oy: number): { x: number; y: number } => {
+    const bez = sampleEdgePath(drawnEdgePoints(e.edgeGeo));
+    let best: { x: number; y: number } | undefined;
+    let bd = Number.MAX_VALUE;
+    for (const pt of constraintSquare(e.spot!.x + ox, e.spot!.y + oy))
+      for (const b of bez) {
+        const d = Math.hypot(b.x - pt.x, b.y - pt.y);
+        if (best === undefined || d < bd) { best = pt; bd = d; }
+      }
+    return best!;
+  };
+  // entries arrive in link order; link1 = the LATER link of the pair (getTwoLastLinks)
+  const state = new Map<object, { x1?: { x: number; y: number }; x2?: { x: number; y: number } }>();
+  const lines = new Map<ConstraintEntry, [{ x: number; y: number }, { x: number; y: number }]>();
+  for (const [pass, ox, oy] of [[0, 0, 0], [1, Dx, Dy]] as const) {
+    for (const e of entries) {
+      const pair = entries.filter((o) => o.constraint === e.constraint);
+      const isLink1 = pair.indexOf(e) === pair.length - 1;
+      const st = state.get(e.constraint) ?? {};
+      state.set(e.constraint, st);
+      const p = pick(e, ox, oy);
+      const inFinalShifted = { x: p.x - Dx, y: p.y - Dy }; // drawn at ug (final frame) -> shifted frame
+      if (isLink1) st.x1 = inFinalShifted; else st.x2 = inFinalShifted;
+      if (pass === 1 && st.x1 && st.x2) lines.set(e, [st.x1, st.x2]);
+    }
+  }
+  for (const [e, [a, b]] of lines) {
+    e.edgeGeo.constraint = { line: { x1: a.x, y1: a.y, x2: b.x, y2: b.y }, text: e.constraint.text };
+  }
+}
