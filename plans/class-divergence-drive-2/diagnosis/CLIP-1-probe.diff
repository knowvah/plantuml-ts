@@ -106,6 +106,20 @@ export function clipClusterEdgeEnds(
   if (tail !== undefined) result = clipSplineStart(result, tail);
   const head = endId !== undefined ? clusterRects.get(endId) : undefined;
   if (head !== undefined) result = clipSplineEnd(result, head);
+  const force = (r: any, pt: { x: number; y: number }) => {
+    if (r === undefined || r.folder !== true) return 0;
+    const x = pt.x - r.x, y = pt.y - r.y, w = r.wtitle, h = r.htitle;
+    if (x >= w && y >= 0 && y <= h) return h;
+    if (y <= 0 && x >= w + 7) return h;
+    if (y <= 0 && x >= w - 7) return h * ((x - (w - 7)) / 14);
+    return 0;
+  };
+  if (result === points) result = points.map((p) => ({ ...p }));
+  const n = result.length;
+  const f2 = force(head, result[n - 1]!);
+  if (f2 !== 0) { result[n - 1] = { x: result[n - 1]!.x, y: result[n - 1]!.y + f2 }; result[n - 2] = { x: result[n - 2]!.x, y: result[n - 2]!.y + f2 }; }
+  const f1 = force(tail, result[0]!);
+  if (f1 !== 0) { process.stderr.write('TAILFORCE ' + f1 + '\n'); result[0] = { x: result[0]!.x, y: result[0]!.y + f1 }; result[1] = { x: result[1]!.x, y: result[1]!.y + f1 }; }
   return result;
 }
 
