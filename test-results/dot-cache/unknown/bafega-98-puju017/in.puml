@startnwdiag
    nwdiag {
        group {
            description = "A";
            fed_a;
            dataSource;
            FSA;
        }
        group {
            description = "B";
            FSB;
            userB;
            searchB;
        }
        fed_a [shape = queue];
        fed_a -- dataSource;
        network scope_A {
            dataSource [shape = collections];
            FSA;
        }
          network middle{
           width = full;
           FSA [shape = cloud];
           FSB [shape = cloud];
          }
        network scope_B {
            FSB;
            userB [shape = actor];
        }
        userB -- searchB;
        searchB;
    }
@endnwdiag