.serena/
.playwright-mcp/
.idea/
.claire/
memory/
node_modules/
dist/
dist-demo/
coverage/
.claude/
# .agent-notes/ is deliberately NOT ignored. It was, until 2026-08-13, while 86
# notes were already tracked -- so the rule only ever hid NEW notes, silently,
# from the one audience they exist for. That cost a full re-derivation of an
# already-diagnosed defect (see .agent-notes/class-edge-spline-2dp-quantization
# .md, re-diagnosed from scratch because the note was one `cat` away and nobody
# knew). rules/memory.md requires reading these before starting a task; a note
# only the authoring machine can see cannot be read.
.mcp.json
# Run artifacts are throwaway, with ONE exception: dot-cache holds jar-derived
# DOT/SVG oracle output that 15 test files read directly, so a clean checkout
# (i.e. CI) cannot run them without it. Same category as oracle/goldens, which
# is committed for the same reason. Regenerating it needs Java, the pinned
# oracle jar and the pdiff corpus — none of which exist on a CI runner.
test-results/*
!test-results/dot-cache/
*.debug.ts
inspect-*.ts
sequence-*.png
# root-level debug renders (e.g. dot-*.png, noleta-*.png, visual-index-*.png)
/*.png
tests/corpus/

.serena/cache/

# Corpus reference PNGs (generated locally, not committed)
tests/visual/reference/
!tests/visual/reference/*/canonical.png

# Generated visual QA pages (re-generated by npm run visual:build)
tests/visual/*.html
tests/visual/index.html

# Visual QA manifests ARE committed (small, useful as reference)
# tests/visual/data/ — intentionally not ignored

# R2 upload manifest (local tracking only)
tests/visual/.r2-upload-manifest.json

# Wrangler local dev cache
.wrangler/

# PlantUML oracle-jar trace droppings (DotStringFactory.getTraceFile)
/svek.dot
/svek.svg

# VitePress build output / cache
docs-site/.vitepress/dist
docs-site/.vitepress/cache

# Generated docs-site copies (mirrored by docs-site/copy-reports.mjs from
# docs/parity-report.md and DIVERGENCES.md at docs:dev/docs:build time)
docs-site/parity.md
docs-site/divergences.md

# Vendored plantuml-stdlib payload (scripts/vendor-stdlib.ts) — regenerable, byte-verbatim copy; audited via assets/stdlib.manifest.json
assets/stdlib/

# Generated per-bundle BundleData modules (scripts/build-stdlib-packages.ts)
# — regenerable from assets/stdlib/ + assets/manifests/, never committed.
packages/*/generated/
