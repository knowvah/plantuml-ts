# `@knowvah/theme` is published to GitHub Packages; every other @knowvah
# package lives on registry.npmjs.org (the workspace packages here publish
# there too). A scope can point at one registry only, so the npmjs ones are
# pinned as tarball URLs in package.json, and every package this repo
# publishes carries `publishConfig.registry` so `npm publish` is not
# redirected by this line. Auth for npm.pkg.github.com comes from ~/.npmrc
# locally and from actions/setup-node + NODE_AUTH_TOKEN in CI — never here.
@knowvah:registry=https://npm.pkg.github.com
