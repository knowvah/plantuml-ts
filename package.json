{
  "name": "@knowvah/plantuml-ts",
  "version": "0.2.0",
  "description": "A TypeScript port of PlantUML: parse PlantUML source and render SVG synchronously, in the browser or Node, with no server and no Java",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/knowvah/plantuml-ts.git"
  },
  "keywords": [
    "plantuml",
    "uml",
    "diagram",
    "svg",
    "renderer",
    "graphviz",
    "dot",
    "class-diagram",
    "sequence-diagram",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/plantuml-ts.cjs",
  "module": "./dist/plantuml-ts.js",
  "types": "./dist/plantuml-ts.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "import": "./dist/plantuml-ts.js",
      "require": "./dist/plantuml-ts.cjs"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build",
    "catalog": "jiti scripts/generate-catalog.ts",
    "catalog:check": "jiti scripts/generate-catalog.ts --check",
    "build:demo": "vite build --config demo/vite.config.ts",
    "build:stdlib": "npm run build && jiti scripts/build-stdlib-packages.ts && npm run typecheck --workspaces --if-present",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern src tests demo scripts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "visual:classify": "jiti scripts/classify-corpus.ts",
    "visual:capture": "jiti scripts/capture-corpus.ts --type dot",
    "visual:build": "vite build && jiti scripts/build-pages.ts",
    "visual:upload": "jiti scripts/upload-references.ts  --type dot",
    "visual": "npm run visual:build && npx serve .",
    "manifest": "jiti scripts/render-manifest.ts",
    "svg:survey": "jiti scripts/svg-parity-survey.ts",
    "svg:dashboard": "jiti scripts/svg-parity-dashboard.ts",
    "docs:brand": "node docs-site/copy-brand-assets.mjs",
    "docs:copy-reports": "node docs-site/copy-reports.mjs",
    "docs:dev": "npm run docs:brand && npm run docs:copy-reports && vitepress dev docs-site",
    "docs:build": "npm run docs:brand && npm run docs:copy-reports && vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "prepare": "husky",
    "format": "prettier --write",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@knowvah/dot-engine": "https://registry.npmjs.org/@knowvah/dot-engine/-/dot-engine-1.6.0.tgz",
    "jsonc-parser": "^3.3.1",
    "katex": "^0.18.7"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@knowvah/theme": "0.3.0",
    "@microsoft/api-extractor": "^7.59.1",
    "@playwright/test": "^1.63.0",
    "@shikijs/themes": "^4.4.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "shiki": "^4.4.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "vitepress": {
      "vite": "^7.3.6",
      "@vitejs/plugin-vue": "^6.0.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=26"
  },
  "volta": {
    "node": "26.9.0"
  }
}
