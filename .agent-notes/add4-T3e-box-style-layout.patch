+      return { x: NO_FUDGE, y: NO_FUDGE };
+    case 'procedure':
+      return { x: RECT_FUDGE, y: { near: RECT_FUDGE.near, far: 0 } };
+    case 'task':
+    case 'object':
+      return { x: RECT_FUDGE, y: RECT_FUDGE };
