{
  "name": "@knowvah/plantuml-sprites-archimate",
  "version": "0.1.0",
  "description": "Vendored ArchiMate sprite artwork (MIT) for plantuml-ts <<$archimate/...>> stereotypes",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/sseely/plantuml-ts.git",
    "directory": "packages/sprites-archimate"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "copy-assets": "node scripts/copy-assets.mjs",
    "prepack": "npm run copy-assets"
  },
  "files": [
    "assets",
    "index.js",
    "index.d.ts",
    "LICENSE",
    "LICENSES.md",
    "README.md"
  ],
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@knowvah/plantuml-ts": "^0.1.0"
  },
  "devDependencies": {
    "@knowvah/plantuml-ts": "file:../.."
  },
  "publishConfig": {
    "access": "public"
  }
}
